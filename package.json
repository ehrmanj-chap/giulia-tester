{
  "name": "giulia-local",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local-only unified Giulia prototype with Qwen routing, local KB retrieval, and forensic eval traces.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "test": "node --test",
    "eval": "node scripts/run-evals.mjs",
    "eval:mock": "node scripts/run-evals.mjs --provider=mock",
    "eval:ollama": "node scripts/run-evals.mjs --provider=ollama",
    "eval:qwen": "node scripts/run-evals.mjs --provider=qwen"
  },
  "engines": { "node": ">=20" }
}
