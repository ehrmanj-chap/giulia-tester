{
  "name": "giulia-local",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Unified Giulia prototype with Qwen routing, local KB retrieval, forensic traces, and batch evaluation.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "test": "node --test",
    "eval": "node scripts/run-evals.mjs",
    "eval:mock": "node scripts/run-evals.mjs --provider=mock",
    "eval:ollama": "node scripts/run-evals.mjs --provider=ollama",
    "eval:qwen": "node scripts/run-evals.mjs --provider=qwen",
    "batch": "node scripts/run-batch.mjs"
  },
  "engines": { "node": ">=20" }
}
