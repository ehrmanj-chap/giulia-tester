# qwen or mock
GIULIA_PROVIDER=mock

# Qwen credentials. Keep the real key only in your local .env / shell environment.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-max
QWEN_ROUTER_MODEL=qwen3.7-max

# Local server
PORT=8787
HOST=127.0.0.1

# Developer diagnostics. Localhost only by default.
GIULIA_DEV_DIAGNOSTICS=true
GIULIA_TRACE_WRITES=true
