# ollama, mock, or qwen
GIULIA_PROVIDER=ollama

# Riverbot-style local Ollama/Qwen defaults
OLLAMA_ENDPOINT=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_ROUTER_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_MS=120000

# Optional hosted Qwen adapter (not needed for local lab testing)
DASHSCOPE_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.5:9b
QWEN_ROUTER_MODEL=qwen3.5:9b
QWEN_TIMEOUT_MS=90000

# Local Giulia server
PORT=8787
HOST=127.0.0.1

# Developer diagnostics. Localhost only by default.
GIULIA_DEV_DIAGNOSTICS=true
GIULIA_TRACE_WRITES=true
