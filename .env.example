# ollama, mock, or qwen
GIULIA_PROVIDER=ollama

# Local Ollama/Qwen defaults
OLLAMA_ENDPOINT=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_ROUTER_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_MS=120000

# Hosted Qwen-compatible provider. Keep this key on the backend only.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.5:9b
QWEN_ROUTER_MODEL=qwen3.5:9b
QWEN_TIMEOUT_MS=90000

# Giulia server. For a cloud container, HOST is normally 0.0.0.0.
PORT=8787
HOST=127.0.0.1

# Online lab access. Set GIULIA_ALLOWED_ORIGIN to the GitHub Pages origin in production.
# Example: https://ehrmanj-chap.github.io
GIULIA_ALLOWED_ORIGIN=*
# Strongly recommended when the backend is reachable from the internet.
GIULIA_LAB_TOKEN=

GIULIA_DEV_DIAGNOSTICS=true
GIULIA_TRACE_WRITES=true
